# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selections
GROQ_PRIMARY_MODEL=llama-3.1-8b-instant
GROQ_CONTEXT_MODEL=llama-3.3-70b-versatile

# Database Configuration
# Default is SQLite for easy local setup. Change to postgresql://user:password@localhost:5432/dbname for Postgres.
DATABASE_URL=sqlite:///./aicrm.db
